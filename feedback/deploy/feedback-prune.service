[Unit]
Description=Delete feedback comments and emails past their retention period

[Service]
Type=oneshot
User=feedback
Group=feedback
WorkingDirectory=/opt/four-corners
EnvironmentFile=/etc/feedback.env
# Keep this number equal to retention_days in data/manual/feedback.json, which the form tells visitors.
ExecStart=/usr/bin/python3 -m feedback.server prune --data ${FEEDBACK_DATA} --days 90
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/feedback
