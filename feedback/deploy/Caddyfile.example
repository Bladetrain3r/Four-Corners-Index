# /etc/caddy/Caddyfile: Caddy obtains and renews the certificate for this name by itself.
feedback.example.org {
	encode gzip
	reverse_proxy 127.0.0.1:8787
	# Caddy logs nothing about visitors by default; leave it that way (no `log` block), the service logs method, path and status only.
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
