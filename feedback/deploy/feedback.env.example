# /etc/feedback.env  (chmod 600). One line each, no quotes.
FEEDBACK_DATA=/var/lib/feedback/feedback.jsonl
FEEDBACK_ORIGINS=https://bladetrain3r.github.io
# Optional mail (Amazon SES SMTP interface shown):
# FEEDBACK_SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# FEEDBACK_SMTP_PORT=587
# FEEDBACK_SMTP_USER=...
# FEEDBACK_SMTP_PASS=...
# FEEDBACK_MAIL_TO=you@example.org
# FEEDBACK_MAIL_FROM=feedback@example.org
