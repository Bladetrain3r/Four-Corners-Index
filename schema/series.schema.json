{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalised series point",
  "description": "One value of one series for one period. Every value on the site traces to a raw snapshot via raw_sha256.",
  "type": "object",
  "required": [
    "source",
    "series_id",
    "region",
    "layer",
    "period_start",
    "period_end",
    "value",
    "unit",
    "as_of",
    "retrieved_at",
    "raw_sha256",
    "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "series_id": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "enum": [
        "cost",
        "mix",
        "driver"
      ]
    },
    "buyer_type": {
      "enum": [
        "household",
        "industrial",
        "wholesale"
      ]
    },
    "fuel": {
      "type": "string",
      "minLength": 1
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "confidence": {
      "enum": [
        "primary",
        "low_confidence",
        "high_latency"
      ],
      "description": "Ziggy, STOP-1 decision 8: sourced bands are primary; low-confidence or high-latency equivalents are highlighted as such."
    },
    "component": {
      "type": "string",
      "minLength": 1,
      "description": "Price component code where the source provides one (EU annual components)."
    },
    "source_flag": {
      "type": "string",
      "minLength": 1,
      "description": "Publisher's data flag, e.g. p = provisional."
    }
  }
}
