{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Published index value (one ledger line)",
  "type": "object",
  "required": ["index", "month", "value_usd_per_kwh", "status", "published", "prev_hash", "hash"],
  "additionalProperties": true,
  "properties": {
    "index": {"enum": ["retail", "wholesale"]},
    "month": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"},
    "value_usd_per_kwh": {"type": "number"},
    "status": {"enum": ["provisional", "final"]},
    "published": {"type": "string", "format": "date"},
    "supersedes": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prev_hash": {"type": "string", "pattern": "^([0-9a-f]{64}|GENESIS)$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
