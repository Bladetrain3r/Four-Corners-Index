{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Published index value (one ledger line)",
  "type": "object",
  "required": [
    "index",
    "month",
    "value_usd_per_kwh",
    "index_2015_100",
    "status",
    "composition",
    "method_version",
    "published",
    "inputs_sha256",
    "prev_hash",
    "hash"
  ],
  "additionalProperties": false,
  "properties": {
    "index": {
      "enum": [
        "retail",
        "wholesale"
      ]
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "value_usd_per_kwh": {
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{6}$",
      "description": "USD per kWh, six decimals, as a string so the hash never depends on float formatting"
    },
    "status": {
      "enum": [
        "provisional",
        "final"
      ]
    },
    "published": {
      "type": "string",
      "format": "date"
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|GENESIS)$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "index_2015_100": {
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{3}$"
    },
    "composition": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "method_version": {
      "type": "integer",
      "minimum": 1
    },
    "inputs_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "backfill": {
      "type": "boolean"
    }
  }
}
